# ============================================================
# 城市公共设施智能报修与派单系统 - 环境变量模板
# 作用：定义所有运行时可配置参数，复制为 .env 后按实际环境修改
# 已按宿主机已有容器（mysql8/redis/room-es/rabbitmq）校准
# ============================================================

# --- 应用基础 ---
APP_NAME="CityRepairSystem"
APP_VERSION="3.0.0"
DEBUG=true
SECRET_KEY="your-app-secret-key"

# --- MySQL（宿主机已有 mysql8:8.4.9）---
# 注意：需要在 mysql8 容器内手动创建 city_repair 数据库和用户
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=your-mysql-database
MYSQL_POOL_SIZE=20

# --- Redis（宿主机已有 redis:7.4.9）---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB_CACHE=0
REDIS_DB_GEO=1
REDIS_DB_LOCK=2
REDIS_DB_COUNTER=3

# --- MongoDB（docker-compose 启动，mongo:6）---
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=your-mongo-user
MONGO_PASSWORD=your-mongo-password
MONGO_DATABASE=your-mongo-database

# --- Elasticsearch（宿主机已有 room-es:8.12.0）---
ES_HOST=127.0.0.1
ES_PORT=9200
ES_INDEX_PREFIX=your-es-index-prefix

# --- RabbitMQ（宿主机已有 rabbitmq:management，默认凭证 guest/guest）---
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=your-rabbitmq-user
RABBITMQ_PASSWORD=your-rabbitmq-password
RABBITMQ_VHOST=/

# --- Dify AI (deprecated: replaced by LangChain + 百炼, 保留用于回退) ---
DIFY_API_BASE_URL=http://127.0.0.1:5001/v1
DIFY_API_KEY_NLP=your-dify-nlp-api-key
DIFY_API_KEY_DISPATCH=your-dify-dispatch-api-key
DIFY_API_KEY_VERIFY=your-dify-verify-api-key

# --- LLM (LangChain + 阿里云百炼 DashScope OpenAI 兼容模式) ---
# 使用 qwen-vl-max-latest 视觉模型，支持图片理解（NLP 图片分析 + 验收照片对比）
LLM_API_KEY=your-llm-api-key
LLM_MODEL_NAME=qwen-vl-max-latest
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.3
LLM_ENABLE_DISPATCH_SCORING=false

# --- JWT ---
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OSS (阿里云对象存储 · 北京地域) ---
OSS_REGION=cn-beijing
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_INTERNAL_ENDPOINT=oss-cn-beijing-internal.aliyuncs.com
OSS_BUCKET=your-oss-bucket
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_MAX_FILE_SIZE_MB=10
OSS_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,bmp
OSS_PUBLIC_BASE_URL=

# --- 阿里云号码认证 (DypnsAPI GetMobile, 复用 OSS 同一账号) ---
DYPNS_ACCESS_KEY_ID=your-access-key-id
DYPNS_ACCESS_KEY_SECRET=your-access-key-secret
DYPNS_REGION=cn-hangzhou

# --- 高德地图 API ---
# Web服务 key（后端 IP 定位 / 逆地理编码 / 地理编码调用）
AMAP_API_KEY=your-amap-api-key
# Web端 JS API 安全密钥（前端 H5/小程序加载高德 JS API 使用）
AMAP_SECURITY_KEY=your-amap-security-key
